<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Bu flavor push bildirimi kullanmıyor: firebase_messaging'in eklediği
         bildirim iznini çıkar (Play'deki izin listesi değişmesin). -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />
</manifest>
